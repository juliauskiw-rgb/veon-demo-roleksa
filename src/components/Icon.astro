---
// Small line icons drawn for this site (no icon font, no emoji). Decorative: the text label always sits next to them.
interface Props { name: "phone" | "menu" | "close" | "chevron"; class?: string; [key: string]: unknown; }
const { name, class: cls, ...rest } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" {...rest}>
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
</svg>
